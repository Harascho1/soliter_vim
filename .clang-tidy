# Linter / staticka analiza (hvata bugove, NE formatira kod).
# Za formatiranje vidi .clang-format.
Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  misc-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-isolate-declaration,
  -misc-no-recursion

WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file
